{
  "name": "checkout51/hyperwallet-php-sdk",
  "description": "A library to manage users, transfer methods and payments through the Hyperwallet API",
  "type": "library",
  "keywords": [
    "hyperwallet",
    "sdk",
    "rest",
    "bankaccount",
    "payout",
    "creditcard",
    "ach"
  ],
  "homepage": "https://github.com/hyperwallet/php-sdk",
  "license": "MIT",
  "authors": [
    {
      "name": "Florian Krauthan",
      "email": "fkrauthan@hyperwallet.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.3 || ^8.0",
    "psr/http-client": "^1.0"
  },
  "autoload": {
    "psr-4": { "Hyperwallet\\": "src/Hyperwallet" }
  },
  "autoload-dev" : {
    "psr-4": { "Hyperwallet\\Tests\\" : "tests/Hyperwallet/Tests" }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phake/phake": "^4.6"
  }
}
